<!doctype html><html lang="en"><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>Travelers’ Challenge</title><style>*{box-sizing:border-box}body{margin:0;background:#34204c;color:white;font-family:Arial,sans-serif}main{max-width:1470px;margin:auto}.board{position:relative;container-type:inline-size}.board img{width:100%;display:block}.overlay{position:absolute;display:flex;align-items:center;justify-content:center;font-size:1.6cqw;font-weight:bold;border-radius:1cqw}input{width:100%;height:100%;border:0;background:#fffdf4;border-radius:1cqw;padding:0 .6cqw;font:inherit;color:#40235c}button{font:inherit;cursor:pointer}.choice{background:#ffe4a5;border:1px solid #bd792e;color:#44240e}.choice.selected{background:#7442a6;color:white;outline:2px solid white}.bank,.drop{gap:.3cqw;background:#fff0c6;flex-wrap:wrap}.tile{border:1px solid #c29aef;background:#692aa0;color:white;border-radius:.7cqw;padding:.35cqw .45cqw;font-size:1.2cqw;touch-action:none}.drop{border:2px dashed #a86b29;color:#784b22}.good{outline:3px solid #25a44d!important}.bad{outline:3px solid #e33!important}.submit{background:transparent;border:0;color:transparent}.score{background:#ffdb61;color:#492600;font-size:2.3cqw}.footer{text-align:center;padding:16px}.footer button{background:#ffda70;color:#43215d;border:0;border-radius:10px;padding:12px 20px;font-weight:bold}@media(max-width:650px){main{min-width:700px}body{overflow-x:auto}}</style><main><div class="board" id="board"><img alt="Travelers’ Challenge Simple Past worksheet" src="data:image/jpeg;base64,"><div id="controls"></div></div><div class="footer"><div id="result" aria-live="polite">Drag the words into the answer boxes, or tap them in order. Tap a placed word to return it.</div><p><button onclick="resetAll()">Try Again</button></p></div></main><script>
const controls=document.getElementById('controls');function place(tag,x,y,w,h,cls,txt){let e=document.createElement(tag);e.className='overlay '+cls;Object.assign(e.style,{left:x/14.7+'%',top:y/8.23+'%',width:w/14.7+'%',height:h/8.23+'%'});e.textContent=txt||'';controls.append(e);return e}for(const [x,w,label] of [[588,218,'Name'],[985,202,'Class']]){let d=place('div',x,185,w,33,'');let i=document.createElement('input');i.setAttribute('aria-label',label);d.append(i)}let score=place('div',1197,49,115,105,'score','0 / 4');let selected=[null,null], choices=[[],[]];[['play','played','plays'],['go','goes','went']].forEach((opts,q)=>opts.forEach((v,i)=>{let b=place('button',q?1008:573,362+i*35,194,33,'choice',String.fromCharCode(65+i)+'. '+v);choices[q].push(b);b.onclick=()=>{selected[q]=i;choices[q].forEach((c,j)=>{c.classList.toggle('selected',j===i);c.classList.remove('good','bad')})}}));let groups=[];[['yesterday.','football','played','He'],['last week.','to school','She','went']].forEach((words,q)=>{let x=q?934:505;let bank=place('div',x,574,386,44,'bank');let drop=place('div',x+9,624,370,53,'drop');drop.setAttribute('aria-label','Answer '+(q+3));let tiles=[];function move(t,d){d.append(t);drop.classList.remove('good','bad')}words.forEach((word,i)=>{let t=document.createElement('button');t.className='tile';t.textContent=word;t.dataset.word=word;t.draggable=true;t.id='t'+q+i;bank.append(t);tiles.push(t);t.onclick=()=>move(t,t.parentNode===bank?drop:bank);t.ondragstart=e=>e.dataTransfer.setData('text/plain',t.id);let start; t.onpointerdown=e=>{if(e.pointerType==='touch'){start=[e.clientX,e.clientY];t.setPointerCapture(e.pointerId)}};t.onpointerup=e=>{if(start){let target=document.elementFromPoint(e.clientX,e.clientY);if(Math.hypot(e.clientX-start[0],e.clientY-start[1])>8){let dest=target?.closest('.bank,.drop');if(dest===bank||dest===drop){move(t,dest);t.onclick=null;setTimeout(()=>t.onclick=()=>move(t,t.parentNode===bank?drop:bank),350)}}start=null}}});[bank,drop].forEach(d=>{d.ondragover=e=>e.preventDefault();d.ondrop=e=>{e.preventDefault();let t=document.getElementById(e.dataTransfer.getData('text/plain'));if(tiles.includes(t)){let before=e.target.closest('.tile');if(before&&before!==t&&before.parentNode===d)d.insertBefore(t,before);else move(t,d)}}});groups.push({bank,drop,tiles})});let submit=place('button',733,709,442,74,'submit','Submit Answers');submit.onclick=()=>{let n=0;[1,2].forEach((a,q)=>{let ok=selected[q]===a;n+=ok;choices[q].forEach((b,i)=>{b.classList.remove('good','bad');if(i===selected[q])b.classList.add(ok?'good':'bad')})});['He played football yesterday.','She went to school last week.'].forEach((a,q)=>{let d=groups[q].drop;let ok=[...d.children].map(t=>t.dataset.word).join(' ')===a;n+=ok;d.classList.remove('good','bad');d.classList.add(ok?'good':'bad')});score.textContent=n+' / 4';document.getElementById('result').textContent=n===4?'Excellent, traveler! 4 / 4':'Score: '+n+' / 4 — Keep practicing!'};function resetAll(){selected=[null,null];choices.flat().forEach(b=>b.classList.remove('selected','good','bad'));groups.forEach(g=>{g.tiles.forEach(t=>g.bank.append(t));g.drop.classList.remove('good','bad')});score.textContent='0 / 4';document.getElementById('result').textContent='Try again! Drag or tap the words.'}</script></html>